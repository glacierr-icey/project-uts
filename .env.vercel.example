# Environment variables untuk deploy Laravel ke Vercel
# Set nilai-nilai ini di Vercel Dashboard: Project Settings > Environment Variables
# (jangan commit file .env asli)

APP_NAME="Apotek App"
APP_ENV=production
APP_KEY=base64:PASTE_HASIL_php_artisan_key:generate_--show
APP_DEBUG=false
APP_URL=https://nama-project.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Opsi 1 (paling mudah untuk demo UTS): SQLite di /tmp (EPHEMERAL - data hilang saat cold start/redeploy)
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite

# Opsi 2 (disarankan jika butuh data persisten): database MySQL/Postgres eksternal gratis
# Contoh (isi sesuai provider seperti Aiven, Railway, Neon, Supabase, PlanetScale, dll):
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

VITE_APP_NAME="${APP_NAME}"
