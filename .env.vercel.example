# Environment variables untuk deploy Laravel ke Vercel
# Set di Vercel Dashboard: Project Settings > Environment Variables
# File .env tidak ikut ter-deploy (lihat .vercelignore), jadi semua yang
# dibutuhkan aplikasi harus diset di sana atau memakai default di api/index.php.

APP_NAME="Apotek Sehat Sehati"
APP_ENV=production
# WAJIB: tempel hasil dari `php artisan key:generate --show`, mis.
# APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
# Jika dikosongkan, api/index.php membuat kunci sementara di /tmp
# (tidak disarankan untuk produksi karena session bisa ter-reset).
APP_KEY=
APP_DEBUG=false
APP_URL=https://nama-project.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Log ke stderr agar muncul di Vercel Function Logs.
# Jangan pakai "single": storage/logs bersifat read-only di Vercel.
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --------------------------------------------------------------------------
# Database SQLite di /tmp (ephemeral)
# File database/vercel-seed.sqlite (sudah berisi hasil migrate + seed)
# disalin ke /tmp/database.sqlite saat cold start. Tidak ada migrasi
# yang dijalankan di dalam request, jadi tidak ada risiko timeout 500.
# Data transaksi baru tetap hilang saat cold start / redeploy.
# --------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite

# Alternatif untuk data persisten: gunakan MySQL/Postgres eksternal.
# # DB_CONNECTION=mysql
# # DB_HOST=
# # DB_PORT=3306
# # DB_DATABASE=
# # DB_USERNAME=
# # DB_PASSWORD=

# Driver berbasis file/database tidak bisa dipakai di filesystem read-only.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Semua path cache/compiled view dialihkan ke /tmp oleh api/index.php.
# Tidak perlu diset manual, tetapi boleh dibiarkan di sini sebagai referensi.
# APP_SERVICES_CACHE=/tmp/services.php
# APP_PACKAGES_CACHE=/tmp/packages.php
# APP_CONFIG_CACHE=/tmp/config.php
# APP_ROUTES_CACHE=/tmp/routes.php
# VIEW_COMPILED_PATH=/tmp/views

VITE_APP_NAME="${APP_NAME}"
